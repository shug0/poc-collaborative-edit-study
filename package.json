  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/node": "^20",
    "@vitest/ui": "^3.2.4",
    "happy-dom": "^21.0.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
